# ==============================================================================
# SFTP Configuration
# ==============================================================================
SFTP_HOST=sftp.example.com
SFTP_PORT=22
SFTP_USERNAME=your_sftp_user
SFTP_PASSWORD=your_sftp_password
SFTP_REMOTE_DIR=/incoming
SFTP_FILE_PATTERN=sales_*.csv
SFTP_STRICT_HOST_KEY_CHECK=true
SFTP_KNOWN_HOSTS_FILE=known_hosts

# ==============================================================================
# Snowflake Configuration
# ==============================================================================
SNOWFLAKE_ACCOUNT=your_snowflake_account_locator
SNOWFLAKE_USER=etl_loader
SNOWFLAKE_PASSWORD=your_secure_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=RETAIL_DB
SNOWFLAKE_SCHEMA=SALES_SCHEMA

# ==============================================================================
# Email Alerting Configuration (Optional)
# ==============================================================================
ALERT_EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=your_app_password
ALERT_RECIPIENT_EMAILS=data-team@example.com
